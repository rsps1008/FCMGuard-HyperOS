<?xml version="1.0" encoding="utf-8"?>
<com.rsps1008.fcmguard.CollapsingStatusCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statusCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/statusHeaderPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_title" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusHeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_ready" android:textColor="@color/green" android:textSize="25sp" android:textStyle="bold" android:paddingTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusDetailsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/status_header_bg"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/currentValuePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tonal_bg"
        android:layout_marginTop="13dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_value_title" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/currentValueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" android:paddingTop="4dp" />
    </LinearLayout>
</com.rsps1008.fcmguard.CollapsingStatusCard>
