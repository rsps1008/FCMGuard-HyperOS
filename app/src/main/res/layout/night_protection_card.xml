<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_gap" android:orientation="vertical"
    android:background="@drawable/card_bg">
    <TextView android:id="@+id/nightTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/night_title"
        android:textColor="@color/text_primary" android:textSize="16sp" android:paddingTop="8dp" />
    <Switch android:id="@+id/nightSwitch" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:text="@string/night_toggle" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/nightSummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/night_disabled"
        android:textColor="@color/text_primary" android:textSize="15sp" android:paddingTop="8dp" />
    <TextView android:id="@+id/nightWarning" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/night_warning"
        android:textColor="@color/text_secondary" android:textSize="13sp" android:paddingTop="8dp" />
    <TextView android:id="@+id/nightExperimental" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/night_experimental"
        android:textColor="@color/text_secondary" android:textSize="13sp" android:paddingTop="8dp" />
    <Button android:id="@+id/nightCleanup" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
        android:text="@string/night_cleanup" android:textAllCaps="false"
        android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg"
        android:visibility="gone" />
</LinearLayout>
