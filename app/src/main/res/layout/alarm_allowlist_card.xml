<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_gap" android:orientation="vertical"
    android:background="@drawable/card_bg">
    <Switch android:id="@+id/alarmListSwitch" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/alarm_list_title"
        android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/alarm_list_explanation" android:textColor="@color/text_secondary"
        android:textSize="13sp" android:lineSpacingExtra="2dp" android:paddingTop="5dp" />
    <TextView android:id="@+id/alarmListSummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/alarm_list_waiting"
        android:textColor="@color/text_primary" android:textSize="13sp" android:paddingTop="8dp" />
    <LinearLayout android:id="@+id/alarmListActionsRow" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/alarmListRestoreBuiltIns" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="@string/alarm_list_restore_builtins" android:textAllCaps="false"
            android:textSize="13sp" android:textColor="@color/text_primary"
            android:background="@drawable/secondary_button_bg" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button android:id="@+id/alarmListSyncNow" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:text="@string/alarm_list_sync_now" android:textAllCaps="false"
            android:textSize="13sp" android:textColor="@color/aurogon_action_text"
            android:background="@drawable/aurogon_action_button_bg" />
    </LinearLayout>
    <Button android:id="@+id/alarmListViewSetting" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp"
        android:text="@string/alarm_list_view" android:textAllCaps="false"
        android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
</LinearLayout>
